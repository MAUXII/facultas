# Supabase (obrigatorio)
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_anon_key

# Google Search Console (opcional)
# Cole só o content= do meta google-site-verification
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Google Calendar (opcional — no dashboard Supabase + Google Cloud)
# Auth → Providers → Google → adicionar escopo:
#   https://www.googleapis.com/auth/calendar.events
# Google Cloud → APIs → ativar "Google Calendar API"
# OAuth consent → adicionar o mesmo escopo
